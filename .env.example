# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Run `python scripts/probe.py` after setting these. It makes one call per
# integration and tells you which ones actually work, with the real data shape.
# Nothing in this repo should be trusted until that passes.

# --- required for anything interesting to happen -------------------------
# Track C: the Claude engine. Track A: pain-point inference and the draft.
# Also writes the AEO recommendations.
ANTHROPIC_API_KEY=

# Track C: Google AI Overviews. Track A: the LinkedIn person and company scrapes.
# Without it, AI Overviews degrades to a marked seam and Track A cannot enrich.
APIFY_TOKEN=

# Track A: finds the LinkedIn profile behind a name and an email.
# serper.dev — real Google results, so `site:` behaves as typed. 2,500 free
# credits, no card. Without it Track A has no way to turn a name into a URL.
SERPER_API_KEY=

# --- optional ------------------------------------------------------------
# Fallback search backend. exa.ai — 20,000/month free, recurring, no card.
# It is a neural index rather than a Google mirror, so `site:` is honoured less
# literally; Serper is tried first for that reason.
EXA_API_KEY=

# Absent = that engine stays a declared seam, which is the honest default.
# Each adapter is one function with the same return shape as the live ones, so
# setting either of these closes the seam with no other change.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
