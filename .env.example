# Copy to .env and fill in. .env is gitignored and must stay that way.

# Live engine 1 — Claude with the web_search tool.
ANTHROPIC_API_KEY=

# Live engine 2 — Google AI Overviews, captured through Apify.
# Without this the AI Overviews engine degrades to a marked seam rather than failing.
APIFY_TOKEN=

# Optional. Absent = that engine stays a declared seam, which is the honest default.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
